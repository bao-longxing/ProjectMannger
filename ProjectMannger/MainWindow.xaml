                                       Text="基于 FFmpeg.AutoGen 的多路 RTSP 采集框架"
                                       FontSize="12" Foreground="{DynamicResource Theme.TextMuted}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                        </Grid>

                        <!-- 当前任务 -->
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="当前任务" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,0,12"/>
                            <TextBlock x:Name="DetailCurrentTask" Text="优化硬解码性能，支持自动选择最优解码器"
                                       FontSize="12" Foreground="{DynamicResource Theme.TextTertiary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 下一步计划 -->
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="下一步计划" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,0,12"/>
                            <TextBlock x:Name="DetailNextPlan" Text="增加音频采集支持，完善性能监控模块"
                                       FontSize="12" Foreground="{DynamicResource Theme.TextTertiary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- 日志标签内容（代码动态填充） -->
                    <StackPanel x:Name="LogsPanel" Visibility="Collapsed"/>

                    <!-- 问题标签内容（代码动态填充） -->
                    <StackPanel x:Name="IssuesPanel" Visibility="Collapsed"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
        </Grid>
        </Border>
    </Border>
</Window>
